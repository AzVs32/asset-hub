{
  "manifest_version": 4,
  "plugin": {
    "id": "resource.image",
    "name": "Resource Image",
    "version": "0.1.0",
    "publisher": "azvs",
    "description": "Thumbnail rendering for common image resources matched by content metadata."
  },
  "runtime": {
    "type": "extism",
    "wasi": false,
    "plugin_api": "asset-hub.plugin-api@1"
  },
  "capabilities": {
    "resource_kinds": [],
    "resource_actions": [
      {
        "id": "resource.image.thumbnail",
        "provides": "thumbnail",
        "label": "Image Thumbnail",
        "description": "Display the original image as its resource thumbnail.",
        "handler": "render_thumbnail",
        "applies_to": {
          "mime_types": [
            "image/*"
          ],
          "extensions": [
            ".png",
            ".jpg",
            ".jpeg",
            ".gif",
            ".webp",
            ".svg",
            ".bmp",
            ".avif",
            ".ico",
            ".tif",
            ".tiff"
          ]
        },
        "access": "read",
        "output": {
          "views": [
            "media"
          ]
        },
        "ui": {
          "group": "preview",
          "order": 10,
          "locations": [
            "resource_thumbnail"
          ]
        }
      }
    ]
  },
  "permissions": {
    "allow": [
      "resource.read"
    ]
  }
}
