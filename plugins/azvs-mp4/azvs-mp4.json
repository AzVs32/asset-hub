{
  "manifest_version": 2,
  "plugin": {
    "id": "azvs.mp4",
    "name": "AzVs MP4",
    "version": "0.1.0",
    "publisher": "azvs",
    "description": "MP4 enhancement plugin."
  },
  "runtime": {
    "type": "extism",
    "wasm": "azvs-mp4.wasm",
    "wasi": false,
    "plugin_api": "asset-hub.plugin-api@0.1"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "azvs:mp4",
        "parent": "core:video",
        "label": "MP4",
        "supports_content": true,
        "detect": {
          "mime_types": [
            "video/mp4"
          ],
          "extensions": [
            ".mp4",
            ".m4v"
          ]
        }
      }
    ],
    "resource_actions": [
      {
        "id": "azvs.mp4.play",
        "label": "Play with AzVs MP4",
        "handler": "play_mp4",
        "applies_to": {
          "kinds": [
            "azvs:mp4"
          ]
        },
        "access": "read",
        "views": [
          "media",
          "html",
          "binary_url"
        ],
        "ui": {
          "group": "open",
          "order": 80,
          "locations": [
            "resource_detail",
            "context_menu"
          ]
        }
      }
    ]
  },
  "permissions": {
    "resource": {
      "read": true,
      "write": false
    },
    "content": {
      "read": true,
      "write": false
    },
    "network": false,
    "filesystem": false
  }
}
