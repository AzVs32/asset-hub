{
  "manifest_version": 1,
  "plugin_id": "azvs-mp4",
  "name": "AzVs MP4",
  "version": "0.1.0",
  "publisher": "azvs",
  "extism": {
    "wasm_path": "azvs-mp4.wasm",
    "wasi": false
  },
  "extends_resource_kinds": [
    {
      "kind": "core:video",
      "when": {
        "mime_types": ["video/mp4"],
        "extensions": [".mp4", ".m4v"]
      },
      "actions": [
        {
          "id": "azvs:play_mp4",
          "label": "Play MP4",
          "handler": "play_mp4",
          "access": "read_only"
        }
      ]
    }
  ]
}
