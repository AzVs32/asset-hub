{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v2.json",
  "manifest_version": 2,
  "plugin": {
    "id": "azvs.epub",
    "name": "AzVs EPUB",
    "version": "0.2.0",
    "publisher": "azvs",
    "description": "Secure EPUB 2 and EPUB 3 reader with lazy chapters and embedded book resources."
  },
  "runtime": {
    "type": "extism",
    "wasi": false,
    "plugin_api": "asset-hub.plugin-api@3"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "azvs:epub",
        "parent": "core:resource",
        "label": "EPUB",
        "supports_content": true,
        "detect": {
          "mime_types": [
            "application/epub+zip"
          ],
          "extensions": [
            ".epub"
          ]
        }
      }
    ],
    "resource_actions": [
      {
        "id": "azvs.epub.render",
        "label": "Read",
        "description": "Open the EPUB reader.",
        "handler": "render_epub",
        "applies_to": {
          "kinds": [
            "azvs:epub"
          ]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "output": {
          "views": [
            "plugin_frame",
            "json"
          ]
        },
        "ui": {
          "group": "open",
          "order": 70,
          "locations": [
            "resource_context_menu"
          ]
        }
      },
      {
        "id": "azvs.epub.thumbnail",
        "provides": "thumbnail",
        "label": "EPUB Thumbnail",
        "description": "Extract an EPUB cover thumbnail.",
        "handler": "render_epub_thumbnail",
        "applies_to": {
          "kinds": [
            "azvs:epub"
          ]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "output": {
          "views": [
            "media",
            "json"
          ]
        },
        "ui": {
          "group": "preview",
          "order": 10,
          "locations": [
            "resource_thumbnail"
          ]
        }
      }
    ]
  },
  "permissions": {
    "allow": [
      "resource.read",
      "resource.content.read"
    ]
  }
}
