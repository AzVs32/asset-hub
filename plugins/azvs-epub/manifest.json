{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v1.json",
  "manifest_version": 1,
  "plugin": {
    "id": "azvs.epub",
    "name": "AzVs EPUB",
    "version": "0.2.0",
    "publisher": "azvs",
    "description": "Secure EPUB 2 and EPUB 3 reader with lazy chapters and embedded book resources."
  },
  "runtime": {
    "type": "extism",
    "wasi": false,
    "plugin_api": "asset-hub.plugin-api@1"
  },
  "capabilities": {
    "kinds": [
      {
        "kind": "azvs:epub",
        "parent": "core:document",
        "label": "EPUB",
        "supports_content": true,
        "detect": {
          "mime_types": [
            "application/epub+zip"
          ],
          "extensions": [
            ".epub"
          ]
        }
      }
    ],
    "resource_actions": [
      {
        "id": "azvs.epub.render",
        "label": "Read EPUB",
        "handler": "render_epub",
        "applies_to": {
          "kinds": [
            "azvs:epub"
          ]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": [
          "plugin_frame",
          "json"
        ],
        "ui": {
          "group": "open",
          "order": 70,
          "locations": [
            "resource_detail",
            "context_menu"
          ]
        }
      },
      {
        "id": "azvs.epub.thumbnail",
        "provides": "thumbnail",
        "label": "EPUB Thumbnail",
        "handler": "render_epub_thumbnail",
        "applies_to": {
          "kinds": [
            "azvs:epub"
          ]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": [
          "media",
          "json"
        ],
        "ui": {
          "group": "preview",
          "order": 10,
          "locations": [
            "resource_list_thumbnail"
          ]
        }
      }
    ]
  },
  "permissions": {
    "allow": [
      "resource.read",
      "resource.content.read"
    ]
  }
}
