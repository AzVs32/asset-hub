{
  "manifest_version": 2,
  "plugin": {
    "id": "azvs.epub",
    "name": "AzVs EPUB",
    "version": "0.1.0",
    "publisher": "azvs",
    "description": "EPUB reading plugin."
  },
  "runtime": {
    "type": "extism",
    "wasm": "azvs-epub.wasm",
    "wasi": false,
    "plugin_api": "asset-hub.plugin-api@0.1"
  },
  "web": {
    "root": "dist"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "azvs:epub",
        "parent": "core:document",
        "label": "EPUB",
        "supports_content": true,
        "detect": {
          "mime_types": [
            "application/epub+zip"
          ],
          "extensions": [
            ".epub"
          ]
        }
      }
    ],
    "resource_actions": [
      {
        "id": "azvs.epub.render",
        "label": "Read EPUB",
        "handler": "render_epub",
        "applies_to": {
          "kinds": [
            "azvs:epub"
          ]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": [
          "plugin_frame",
          "json"
        ],
        "ui": {
          "group": "open",
          "order": 70,
          "locations": [
            "resource_detail",
            "context_menu"
          ]
        }
      },
      {
        "id": "azvs.epub.cover",
        "label": "EPUB Cover",
        "handler": "render_epub_cover",
        "applies_to": {
          "kinds": [
            "azvs:epub"
          ]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": [
          "media",
          "json"
        ],
        "ui": {
          "group": "preview",
          "order": 10,
          "locations": [
            "resource_list_thumbnail"
          ]
        }
      }
    ]
  },
  "permissions": {
    "resource": {
      "read": true,
      "write": false
    },
    "content": {
      "read": true,
      "write": false
    },
    "network": false,
    "filesystem": false
  }
}
