{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v3.json",
  "manifest_version": 3,
  "plugin": {
    "id": "azvs.directory.hello",
    "name": "Hello Directory",
    "version": "0.3.0",
    "publisher": "azvs",
    "description": "Minimal Directory workspace plugin with a static greeting."
  },
  "runtime": {
    "type": "extism",
    "wasi": false,
    "plugin_api": "asset-hub.plugin-api@4"
  },
  "capabilities": {
    "directory_kinds": [
      {
        "kind": "azvs:directory.hello",
        "parent": "core:directory",
        "label": "Hello Directory"
      }
    ],
    "directory_actions": [
      {
        "id": "azvs.directory.hello.thumbnail",
        "provides": "thumbnail",
        "label": "Hello thumbnail",
        "description": "Display the Hello Directory thumbnail.",
        "handler": "render_thumbnail",
        "applies_to": {
          "kinds": [
            "azvs:directory.hello"
          ]
        },
        "access": "read",
        "output": {
          "views": [
            "media"
          ]
        },
        "ui": {
          "group": "preview",
          "order": 10,
          "locations": [
            "directory_thumbnail"
          ]
        }
      },
      {
        "id": "azvs.directory.hello.workspace",
        "provides": "workspace",
        "label": "Hello workspace",
        "description": "Display the static Hello Directory workspace.",
        "handler": "render_workspace",
        "applies_to": {
          "kinds": [
            "azvs:directory.hello"
          ]
        },
        "access": "read",
        "output": {
          "views": [
            "plugin_frame"
          ]
        },
        "ui": {
          "group": "workspace",
          "order": 10,
          "locations": [
            "directory_workspace"
          ]
        }
      }
    ]
  },
  "permissions": {
    "allow": [
      "directory.read"
    ]
  }
}
