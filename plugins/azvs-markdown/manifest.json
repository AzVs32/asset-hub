{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v2.json",
  "manifest_version": 2,
  "plugin": {
    "id": "azvs.markdown",
    "name": "AzVs Markdown",
    "version": "0.2.0",
    "publisher": "azvs",
    "description": "Markdown reader and editor using the Asset Hub Web Plugin SDK."
  },
  "runtime": {
    "type": "extism",
    "wasi": true,
    "plugin_api": "asset-hub.plugin-api@3"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "azvs:markdown",
        "parent": "core:text",
        "label": "Markdown",
        "supports_content": true,
        "detect": {
          "mime_types": [
            "text/markdown",
            "text/x-markdown"
          ],
          "extensions": [
            ".md",
            ".markdown",
            ".mdown",
            ".mkd"
          ]
        }
      }
    ],
    "resource_actions": [
      {
        "id": "azvs.markdown.read",
        "provides": "text_read",
        "description": "Open Markdown in the plugin reader.",
        "handler": "render_markdown",
        "applies_to": {
          "kinds": [
            "azvs:markdown"
          ]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "output": {
          "views": [
            "plugin_frame",
            "json"
          ]
        },
        "ui": {
          "group": "open",
          "order": 60,
          "locations": [
            "resource_context_menu"
          ]
        }
      },
      {
        "id": "azvs.markdown.edit",
        "provides": "text_edit",
        "description": "Edit Markdown through the bounded plugin frame bridge.",
        "handler": "update_markdown",
        "applies_to": {
          "kinds": [
            "azvs:markdown"
          ]
        },
        "access": "write",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "output": {
          "views": [
            "plugin_frame",
            "json",
            "text"
          ]
        },
        "ui": {
          "group": "edit",
          "order": 70,
          "locations": [
            "resource_context_menu"
          ]
        }
      }
    ]
  },
  "permissions": {
    "allow": [
      "resource.read",
      "resource.content.replace",
      "resource.content.read"
    ]
  }
}
