{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v3.json",
  "manifest_version": 3,
  "plugin": {
    "id": "azvs.markdown",
    "name": "AzVs Markdown",
    "version": "0.2.0",
    "publisher": "azvs",
    "description": "Markdown reader and editor with bounded postMessage content transfer."
  },
  "runtime": {
    "type": "extism",
    "wasm": "azvs-markdown.wasm",
    "wasi": true
  },
  "web": {
    "root": "dist"
  },
  "capabilities": {
    "kinds": [
      {
        "kind": "azvs:markdown",
        "parent": "core:document",
        "label": "Markdown",
        "supports_content": true,
        "detect": {
          "mime_types": [
            "text/markdown",
            "text/x-markdown"
          ],
          "extensions": [
            ".md",
            ".markdown",
            ".mdown",
            ".mkd"
          ]
        },
        "metadata": {
          "schema_version": 1,
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "readOnly": true,
            "additionalProperties": false,
            "properties": {
              "line_count": {
                "type": "integer",
                "minimum": 0
              },
              "word_count": {
                "type": "integer",
                "minimum": 0
              },
              "heading_count": {
                "type": "integer",
                "minimum": 0
              },
              "has_front_matter": {
                "type": "boolean"
              }
            }
          }
        }
      }
    ],
    "actions": [
      {
        "id": "azvs.markdown.render",
        "label": "Read Markdown",
        "handler": "render_markdown",
        "applies_to": {
          "kinds": [
            "azvs:markdown"
          ]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": [
          "plugin_frame",
          "json"
        ],
        "ui": {
          "group": "open",
          "order": 60,
          "locations": [
            "resource_detail",
            "context_menu"
          ]
        }
      },
      {
        "id": "azvs.markdown.update",
        "label": "Edit Markdown",
        "handler": "update_markdown",
        "applies_to": {
          "kinds": [
            "azvs:markdown"
          ]
        },
        "access": "write",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": [
          "plugin_frame",
          "json",
          "text"
        ],
        "ui": {
          "group": "edit",
          "order": 70,
          "locations": [
            "resource_detail",
            "context_menu"
          ]
        }
      }
    ]
  },
  "permissions": {
    "allow": [
      "resource.metadata.read",
      "resource.metadata.write",
      "content.read",
      "content.replace"
    ]
  }
}
