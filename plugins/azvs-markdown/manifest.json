{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v1.json",
  "manifest_version": 1,
  "plugin": {
    "id": "azvs.markdown",
    "name": "AzVs Markdown",
    "version": "0.2.0",
    "publisher": "azvs",
    "description": "Markdown reader and editor with bounded postMessage content transfer."
  },
  "runtime": {
    "type": "extism",
    "wasi": true,
    "plugin_api": "asset-hub.plugin-api@1"
  },
  "capabilities": {
    "kinds": [
      {
        "kind": "azvs:markdown",
        "parent": "core:text",
        "label": "Markdown",
        "supports_content": true,
        "detect": {
          "mime_types": [
            "text/markdown",
            "text/x-markdown"
          ],
          "extensions": [
            ".md",
            ".markdown",
            ".mdown",
            ".mkd"
          ]
        }
      }
    ],
    "resource_actions": [
      {
        "id": "azvs.markdown.read",
        "provides": "text_read",
        "label": "Read Markdown",
        "handler": "render_markdown",
        "applies_to": {
          "kinds": [
            "azvs:markdown"
          ]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": [
          "plugin_frame",
          "json"
        ],
        "ui": {
          "group": "open",
          "order": 60,
          "locations": [
            "resource_detail",
            "context_menu"
          ]
        }
      },
      {
        "id": "azvs.markdown.edit",
        "provides": "text_edit",
        "label": "Edit Markdown",
        "handler": "update_markdown",
        "applies_to": {
          "kinds": [
            "azvs:markdown"
          ]
        },
        "access": "write",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": [
          "plugin_frame",
          "json",
          "text"
        ],
        "ui": {
          "group": "edit",
          "order": 70,
          "locations": [
            "resource_detail",
            "context_menu"
          ]
        }
      }
    ]
  },
  "permissions": {
    "allow": [
      "resource.read",
      "resource.write",
      "resource.content.read"
    ]
  }
}
