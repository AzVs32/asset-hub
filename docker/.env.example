# Public web port on the Docker host.
ASSET_HUB_PORT=8080

# Optional image tag used by Compose.
ASSET_HUB_IMAGE_TAG=local

# Production-safe HTTP defaults.
ASSET_HTTP_ENABLE_SWAGGER=false
ASSET_HTTP_ENABLE_PURGE=false
ASSET_HTTP_REQUEST_TIMEOUT_SECS=30
ASSET_HTTP_COOKIE_SECURE=false
ASSET_HTTP_SESSION_INACTIVITY_SECS=43200
RUST_LOG=asset_http=info,tower_http=info
