{
  "name": "@asset-hub/asset-web-sdk",
  "version": "0.1.0",
  "description": "Browser authoring SDK for Asset Hub plugin frames.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/asset-web-sdk.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./global": "./dist/asset-web-sdk.global.js"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/asset-web-sdk.js",
  "scripts": {
    "build": "vite build && vite build --config vite.contract.config.ts && tsc --project tsconfig.json --emitDeclarationOnly",
    "check": "biome ci . && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "format": "biome check --write .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.tests.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "penpal": "^7.0.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
