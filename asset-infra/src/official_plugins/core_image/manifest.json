{
  "manifest_version": 1,
  "plugin": {
    "id": "core.image",
    "name": "Core Image",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in image resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "core:image",
        "label": "Image",
        "schema_id": "core:image@1",
        "supports_content": true,
        "detect": {
          "mime_types": ["image/*"],
          "extensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".avif"]
        },
        "metadata_schema": {
          "type": "object",
          "properties": {
            "alt": { "type": "string" },
            "caption": { "type": "string" }
          }
        }
      }
    ],
    "resource_actions": [
      {
        "id": "thumbnail",
        "label": "Thumbnail",
        "description": "Generate an image thumbnail.",
        "executor": {
          "type": "builtin",
          "handler": "builtin.media.thumbnail"
        },
        "applies_to": {
          "kinds": ["core:image"],
          "media_types": ["image/*"],
          "extensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".avif"]
        },
        "access": "read",
        "requires": {
          "resource": true,
          "metadata": true,
          "content": true,
          "content_delivery": "inline"
        },
        "output": {
          "view": ["media"]
        },
        "ui": {
          "group": "preview",
          "order": 40,
          "locations": ["resource_detail"]
        }
      }
    ]
  },
  "permissions": {
    "resource": {
      "read": true,
      "write": false
    },
    "content": {
      "read": true,
      "write": false
    },
    "network": false,
    "filesystem": false
  }
}
