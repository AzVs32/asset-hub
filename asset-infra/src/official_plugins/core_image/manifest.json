{
  "manifest_version": 2,
  "plugin": {
    "id": "core.image",
    "name": "Core Image",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in image resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "core:image",
        "parent": "core:file",
        "label": "Image",
        "supports_content": true,
        "detect": {
          "mime_types": ["image/*"],
          "extensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".avif"]
        }
      }
    ],
    "resource_actions": [
      {
        "id": "thumbnail",
        "label": "Thumbnail",
        "handler": "builtin.media.thumbnail",
        "applies_to": {
          "kinds": ["core:image"]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "inline"
        },
        "views": ["media"],
        "ui": {
          "group": "preview",
          "order": 40,
          "locations": ["resource_detail"]
        }
      }
    ]
  },
  "permissions": {
    "resource": {
      "read": true,
      "write": false
    },
    "content": {
      "read": true,
      "write": false
    },
    "network": false,
    "filesystem": false
  }
}
