{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v3.json",
  "manifest_version": 3,
  "plugin": {
    "id": "core.image",
    "name": "Core Image",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in image resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "kinds": [
      {
        "kind": "core:image",
        "parent": "core:resource",
        "label": "Image",
        "supports_content": true,
        "detect": {
          "mime_types": ["image/*"],
          "extensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".avif"]
        }
      }
    ],
    "actions": []
  },
  "permissions": {
    "allow": ["resource.read", "content.read"]
  }
}
