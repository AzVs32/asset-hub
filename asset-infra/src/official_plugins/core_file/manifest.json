{
  "manifest_version": 1,
  "plugin": {
    "id": "core.file",
    "name": "Core File",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in generic file resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "core:file",
        "label": "File",
        "supports_content": true
      }
    ],
    "resource_actions": [
      {
        "id": "download_content",
        "label": "Download",
        "description": "Download the original resource content.",
        "executor": {
          "type": "builtin",
          "handler": "builtin.content.download"
        },
        "applies_to": {
          "kinds": ["core:file"]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "url"
        },
        "output": {
          "view": ["binary_url"]
        },
        "ui": {
          "group": "open",
          "order": 10,
          "locations": ["resource_detail", "context_menu"]
        }
      },
      {
        "id": "view_inline",
        "label": "View",
        "description": "View supported media inline.",
        "executor": {
          "type": "builtin",
          "handler": "builtin.media.view"
        },
        "applies_to": {
          "kinds": ["core:image", "core:document", "core:video"],
          "media_types": ["image/*", "application/pdf", "video/*"],
          "extensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".avif", ".pdf", ".mp4", ".webm", ".mov", ".m4v", ".ogv"]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "url"
        },
        "output": {
          "view": ["media"]
        },
        "ui": {
          "group": "open",
          "order": 20,
          "locations": ["resource_detail"]
        }
      },
      {
        "id": "preview",
        "label": "Preview",
        "description": "Preview supported media.",
        "executor": {
          "type": "builtin",
          "handler": "builtin.media.preview"
        },
        "applies_to": {
          "kinds": ["core:image", "core:document", "core:video"],
          "media_types": ["image/*", "application/pdf", "video/*"],
          "extensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".avif", ".pdf", ".mp4", ".webm", ".mov", ".m4v", ".ogv"]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "url"
        },
        "output": {
          "view": ["media"]
        },
        "ui": {
          "group": "preview",
          "order": 30,
          "locations": ["resource_detail"]
        }
      }
    ]
  },
  "permissions": {
    "resource": {
      "read": true,
      "write": false
    },
    "content": {
      "read": true,
      "write": false
    },
    "network": false,
    "filesystem": false
  }
}
