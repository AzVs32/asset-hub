{
  "manifest_version": 2,
  "plugin": {
    "id": "core.file",
    "name": "Core File",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in generic file resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "core:file",
        "label": "File",
        "supports_content": true
      }
    ],
    "resource_actions": [
      {
        "id": "download_content",
        "label": "Download",
        "handler": "builtin.content.download",
        "applies_to": {
          "kinds": ["core:file"]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": ["binary_url"],
        "ui": {
          "group": "open",
          "order": 10,
          "locations": ["resource_detail", "context_menu"]
        }
      },
      {
        "id": "view_inline",
        "label": "View",
        "handler": "builtin.media.view",
        "applies_to": {
          "kinds": ["core:image", "core:document", "core:video"]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": ["media"],
        "ui": {
          "group": "open",
          "order": 20,
          "locations": ["resource_detail"]
        }
      },
      {
        "id": "preview",
        "label": "Preview",
        "handler": "builtin.media.preview",
        "applies_to": {
          "kinds": ["core:image", "core:document", "core:video"]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": ["media"],
        "ui": {
          "group": "preview",
          "order": 30,
          "locations": ["resource_detail"]
        }
      }
    ]
  },
  "permissions": {
    "resource": {
      "read": true,
      "write": false
    },
    "content": {
      "read": true,
      "write": false
    },
    "network": false,
    "filesystem": false
  }
}
