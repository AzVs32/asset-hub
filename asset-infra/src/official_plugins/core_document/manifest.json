{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v3.json",
  "manifest_version": 3,
  "plugin": {
    "id": "core.document",
    "name": "Core Document",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in document resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "kinds": [
      {
        "kind": "core:document",
        "parent": "core:file",
        "label": "Document",
        "supports_content": true,
        "detect": {
          "mime_types": ["application/pdf"],
          "extensions": [".pdf"]
        },
        "metadata": {
          "schema_version": 1,
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "readOnly": true,
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "authors": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "BCP 47 language tag when known."
              },
              "page_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    ],
    "actions": []
  },
  "permissions": {
    "allow": ["resource.metadata.read", "content.read"]
  }
}
