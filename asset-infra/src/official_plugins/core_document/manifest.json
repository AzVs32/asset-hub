{
  "manifest_version": 1,
  "plugin": {
    "id": "core.document",
    "name": "Core Document",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in document resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "core:document",
        "label": "Document",
        "schema_id": "core:document@1",
        "supports_content": true,
        "detect": {
          "mime_types": ["application/pdf"],
          "extensions": [".pdf"]
        },
        "metadata_schema": {
          "type": "object",
          "properties": {
            "author": { "type": "string" },
            "title": { "type": "string" }
          }
        }
      }
    ],
    "resource_actions": []
  },
  "permissions": {
    "resource": {
      "read": true,
      "write": false
    },
    "content": {
      "read": true,
      "write": false
    },
    "network": false,
    "filesystem": false
  }
}
