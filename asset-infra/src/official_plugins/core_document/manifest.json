{
  "manifest_version": 2,
  "plugin": {
    "id": "core.document",
    "name": "Core Document",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in document resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "core:document",
        "parent": "core:file",
        "label": "Document",
        "supports_content": true,
        "detect": {
          "mime_types": ["application/pdf"],
          "extensions": [".pdf"]
        }
      }
    ],
    "resource_actions": []
  },
  "permissions": {
    "resource": {
      "read": true,
      "write": false
    },
    "content": {
      "read": true,
      "write": false
    },
    "network": false,
    "filesystem": false
  }
}
