{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v3.json",
  "manifest_version": 3,
  "plugin": {
    "id": "core.directory",
    "name": "Core Directory",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in directory support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "directory_kinds": [
      {
        "kind": "core:directory",
        "label": "Directory"
      }
    ],
    "directory_actions": [
      {
        "id": "core.directory.download",
        "label": "Download",
        "handler": "builtin.directory.download",
        "applies_to": {
          "kinds": ["core:directory"]
        },
        "access": "read",
        "views": ["download"],
        "ui": {
          "group": "open",
          "order": 10,
          "locations": [
            "directory_toolbar",
            "directory_context_menu",
            "directory_detail"
          ]
        }
      }
    ]
  },
  "permissions": {
    "allow": ["directory.read"]
  }
}
