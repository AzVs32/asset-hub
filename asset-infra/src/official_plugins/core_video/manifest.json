{
  "manifest_version": 1,
  "plugin": {
    "id": "core.video",
    "name": "Core Video",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in video resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "resource_kinds": [
      {
        "kind": "core:video",
        "parent": "core:file",
        "label": "Video",
        "supports_content": true,
        "detect": {
          "mime_types": ["video/*"],
          "extensions": [".mp4", ".webm", ".mov", ".m4v", ".ogv"]
        }
      }
    ],
    "resource_actions": []
  },
  "permissions": {
    "resource": {
      "read": true,
      "write": false
    },
    "content": {
      "read": true,
      "write": false
    },
    "network": false,
    "filesystem": false
  }
}
