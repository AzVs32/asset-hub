{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v3.json",
  "manifest_version": 3,
  "plugin": {
    "id": "core.video",
    "name": "Core Video",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in video resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "kinds": [
      {
        "kind": "core:video",
        "parent": "core:file",
        "label": "Video",
        "supports_content": true,
        "detect": {
          "mime_types": ["video/*"],
          "extensions": [".mp4", ".webm", ".mov", ".m4v", ".ogv"]
        }
      }
    ],
    "actions": []
  },
  "permissions": {
    "allow": ["resource.metadata.read", "content.read"]
  }
}
