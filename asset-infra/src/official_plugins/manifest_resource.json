{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v3.json",
  "manifest_version": 3,
  "plugin": {
    "id": "core.resource",
    "name": "Core Resource",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in generic resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "kinds": [
      {
        "kind": "core:resource",
        "label": "Resource",
        "supports_content": true
      }
    ],
    "actions": [
      {
        "id": "core.resource.download",
        "label": "Download",
        "handler": "builtin.content.download",
        "applies_to": {
          "kinds": ["core:resource"]
        },
        "access": "read",
        "requires": {
          "content": true,
          "content_delivery": "reference"
        },
        "views": ["binary_url"],
        "ui": {
          "group": "open",
          "order": 10,
          "locations": ["resource_detail", "context_menu"]
        }
      }
    ]
  },
  "permissions": {
    "allow": ["resource.read", "content.read"]
  }
}
