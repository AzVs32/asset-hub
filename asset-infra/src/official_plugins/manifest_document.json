{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v1.json",
  "manifest_version": 1,
  "plugin": {
    "id": "core.document",
    "name": "Core Document",
    "version": "0.1.0",
    "publisher": "asset-hub",
    "description": "Built-in document resource support."
  },
  "runtime": {
    "type": "builtin"
  },
  "capabilities": {
    "kinds": [
      {
        "kind": "core:document",
        "parent": "core:resource",
        "label": "Document",
        "supports_content": true,
        "detect": {
          "mime_types": ["application/pdf"],
          "extensions": [".pdf"]
        }
      }
    ],
    "resource_actions": []
  },
  "permissions": {
    "allow": ["resource.read", "resource.content.read"]
  }
}
