package assethub:vfs@4.0.0;

interface driver {
    // Request and Reply are protobuf assethub.vfs.v12 messages from plugin.proto.
    // The host owns the Store generation. Guest resource IDs are scoped to it.
    // Both directions use one envelope, including metadata, errors and commit.
    // Each Storage runs in a fresh Store after describe and initialize.
    call: func(request: list<u8>) -> list<u8>;
}

world plugin {
    export driver;
}
