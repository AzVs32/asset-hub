{
  "manifest_version": 2,
  "plugin": {
    "id": "example.plugin",
    "name": "Example Plugin",
    "version": "0.1.0",
    "publisher": "example"
  },
  "runtime": {
    "type": "extism",
    "wasi": false,
    "plugin_api": "asset-hub.plugin-api@2"
  },
  "capabilities": {
    "resource_kinds": [],
    "directory_kinds": [],
    "resource_actions": [
      {
        "id": "example.plugin.action",
        "label": "Example Action",
        "handler": "run",
        "applies_to": {
          "kinds": [
            "core:resource"
          ],
          "mime_types": [],
          "extensions": []
        },
        "access": "read",
        "output": {
          "views": [
            "json"
          ]
        }
      }
    ],
    "directory_actions": []
  },
  "permissions": {
    "allow": [
      "resource.read"
    ],
    "network": false,
    "filesystem": false
  }
}
