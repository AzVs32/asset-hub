{
  "$id": "urn:asset-hub:plugin-contract:directory-resource-page-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginDirectoryResourcePage",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginDirectoryResource"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "$defs": {
    "PluginChecksum": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ]
    },
    "PluginContentReference": {
      "description": "Non-inline object content supplied to a plugin.",
      "type": "object",
      "properties": {
        "encoding": {
          "$ref": "#/$defs/PluginContentReferenceEncoding"
        },
        "reference": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "encoding",
        "reference"
      ]
    },
    "PluginContentReferenceEncoding": {
      "description": "Encoding used by an opaque, call-scoped host content reference.",
      "type": "string",
      "enum": [
        "handle"
      ]
    },
    "PluginContentVerificationStatus": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "failed"
      ]
    },
    "PluginDirectoryResource": {
      "type": "object",
      "properties": {
        "content": {
          "description": "Content metadata exposed by both `metadata` and `content` resource access modes.",
          "anyOf": [
            {
              "$ref": "#/$defs/PluginResourceContent"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_ref": {
          "description": "Opaque, call-scoped reference issued only for readable content in `content` mode.\n\nIt is consumed by the standard content Host ABI and is never a filesystem path.",
          "anyOf": [
            {
              "$ref": "#/$defs/PluginContentReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Stable Resource identity within the current workspace.",
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "revision"
      ]
    },
    "PluginResourceContent": {
      "description": "Resource content reference exposed to plugins.",
      "type": "object",
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginChecksum"
            },
            {
              "type": "null"
            }
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "verification_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "$ref": "#/$defs/PluginContentVerificationStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "size",
        "verification_status"
      ]
    }
  }
}
