{
  "manifest_version": 5,
  "plugin_api": "asset-hub.plugin-api@2",
  "frame": {
    "resource_channel": "asset-hub.plugin-frame@2",
    "directory_channel": "asset-hub.plugin-directory-frame@2",
    "resource_methods": [
      {
        "name": "executeResourceAction",
        "arguments": [
          {
            "name": "action",
            "schema": "string",
            "optional": false
          },
          {
            "name": "input",
            "schema": "JsonObject",
            "optional": true
          }
        ],
        "result_schema": "ResourceFrameActionOutput"
      },
      {
        "name": "replaceResourceText",
        "arguments": [
          {
            "name": "text",
            "schema": "string",
            "optional": false
          }
        ],
        "result_schema": "void"
      }
    ],
    "directory_methods": [
      {
        "name": "executeDirectoryAction",
        "arguments": [
          {
            "name": "action",
            "schema": "string",
            "optional": false
          },
          {
            "name": "input",
            "schema": "JsonObject",
            "optional": true
          }
        ],
        "result_schema": "DirectoryFrameActionOutput"
      },
      {
        "name": "viewResource",
        "arguments": [
          {
            "name": "resourceId",
            "schema": "string",
            "optional": false
          },
          {
            "name": "input",
            "schema": "JsonObject",
            "optional": true
          }
        ],
        "result_schema": "ResourceFrameActionOutput"
      },
      {
        "name": "refreshDirectory",
        "arguments": [],
        "result_schema": "void"
      },
      {
        "name": "navigateToDirectory",
        "arguments": [
          {
            "name": "path",
            "schema": "string",
            "optional": false
          }
        ],
        "result_schema": "void"
      },
      {
        "name": "editResource",
        "arguments": [
          {
            "name": "resourceId",
            "schema": "string",
            "optional": false
          }
        ],
        "result_schema": "void"
      }
    ]
  },
  "capabilities": {
    "resource_actions": [
      "thumbnail",
      "view",
      "edit"
    ],
    "directory_actions": [
      "thumbnail",
      "workspace"
    ]
  },
  "views": [
    "text",
    "markdown",
    "html",
    "plugin_frame",
    "json",
    "media",
    "download"
  ],
  "resource_effects": [
    "replace_content",
    "delete"
  ],
  "directory_effects": [
    "update",
    "create_child",
    "create_tree",
    "delete"
  ],
  "host_functions": [
    {
      "name": "asset_hub_content_open",
      "parameters": [
        {
          "name": "reference",
          "value_type": "string",
          "schema": null
        }
      ],
      "result": "string",
      "result_schema": null,
      "lifecycle": "Returns a call-scoped handle that must be closed before the action returns."
    },
    {
      "name": "asset_hub_content_size",
      "parameters": [
        {
          "name": "handle",
          "value_type": "string",
          "schema": null
        }
      ],
      "result": "u64",
      "result_schema": null,
      "lifecycle": "The handle must have been returned by content_open in the current action call."
    },
    {
      "name": "asset_hub_content_read",
      "parameters": [
        {
          "name": "handle",
          "value_type": "string",
          "schema": null
        },
        {
          "name": "offset",
          "value_type": "u64",
          "schema": null
        },
        {
          "name": "length",
          "value_type": "u64",
          "schema": null
        }
      ],
      "result": "bytes",
      "result_schema": null,
      "lifecycle": "Reads at most the Host policy limit and remaining content bytes."
    },
    {
      "name": "asset_hub_content_close",
      "parameters": [
        {
          "name": "handle",
          "value_type": "string",
          "schema": null
        }
      ],
      "result": "unit",
      "result_schema": null,
      "lifecycle": "Invalidates the call-scoped handle."
    },
    {
      "name": "asset_hub_directory_list_children",
      "parameters": [
        {
          "name": "request",
          "value_type": "json",
          "schema": "DirectoryPageRequest"
        }
      ],
      "result": "json",
      "result_schema": "PluginDirectoryPage",
      "lifecycle": "The request reference is valid only during the current Directory Action call."
    },
    {
      "name": "asset_hub_directory_list_resources",
      "parameters": [
        {
          "name": "request",
          "value_type": "json",
          "schema": "DirectoryPageRequest"
        }
      ],
      "result": "json",
      "result_schema": "PluginDirectoryResourcePage",
      "lifecycle": "The request reference and returned content references are call-scoped."
    }
  ]
}
