{
  "$id": "urn:asset-hub:plugin-contract:directory-resource-page-v4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginDirectoryResourcePage",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginDirectoryResource"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "$defs": {
    "PluginChecksum": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ]
    },
    "PluginContentReference": {
      "description": "Non-inline object content supplied to a plugin.",
      "type": "object",
      "properties": {
        "encoding": {
          "$ref": "#/$defs/PluginContentReferenceEncoding"
        },
        "reference": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "encoding",
        "reference"
      ]
    },
    "PluginContentReferenceEncoding": {
      "description": "Encoding used by an opaque, call-scoped host content reference.",
      "type": "string",
      "enum": [
        "handle"
      ]
    },
    "PluginDirectoryResource": {
      "type": "object",
      "properties": {
        "content": {
          "description": "Content metadata exposed by both `metadata` and `content` resource access modes.",
          "anyOf": [
            {
              "$ref": "#/$defs/PluginResourceContent"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_ref": {
          "description": "Opaque, call-scoped reference issued only for readable content in `content` mode.\n\nIt is consumed by the standard content Host ABI and is never a filesystem path.",
          "anyOf": [
            {
              "$ref": "#/$defs/PluginContentReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Stable Resource identity within the current workspace.",
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "description": "Authoritative Resource state derived by the Host.",
          "$ref": "#/$defs/PluginResourceState"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "revision",
        "state"
      ]
    },
    "PluginResourceContent": {
      "description": "Resource content reference exposed to plugins.",
      "type": "object",
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginChecksum"
            },
            {
              "type": "null"
            }
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "verification_error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "size"
      ]
    },
    "PluginResourceContentState": {
      "type": "string",
      "enum": [
        "absent",
        "pending",
        "verified",
        "failed"
      ]
    },
    "PluginResourceEffectiveState": {
      "type": "string",
      "enum": [
        "deleted",
        "no_content",
        "verifying",
        "ready",
        "verification_failed"
      ]
    },
    "PluginResourceLifecycleState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "active"
            }
          },
          "additionalProperties": false,
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "deleted"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "at"
          ]
        }
      ]
    },
    "PluginResourceState": {
      "description": "Authoritative Resource lifecycle, content, and effective state exposed to plugins.",
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/PluginResourceContentState"
        },
        "effective": {
          "$ref": "#/$defs/PluginResourceEffectiveState"
        },
        "lifecycle": {
          "$ref": "#/$defs/PluginResourceLifecycleState"
        }
      },
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "content",
        "effective"
      ]
    }
  }
}
