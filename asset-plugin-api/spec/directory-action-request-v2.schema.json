{
  "$id": "urn:asset-hub:plugin-contract:directory-action-request-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginDirectoryActionRequest",
  "description": "Directory action request passed from the host to a plugin handler.",
  "type": "object",
  "properties": {
    "access": {
      "$ref": "#/$defs/PluginActionAccess"
    },
    "action": {
      "type": "string"
    },
    "directory": {
      "$ref": "#/$defs/PluginDirectory"
    },
    "directory_ref": {
      "description": "Opaque, call-scoped reference accepted by directory Host APIs.",
      "type": "string"
    },
    "input": {
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "action",
    "access",
    "directory",
    "directory_ref"
  ],
  "$defs": {
    "PluginActionAccess": {
      "description": "Whether the Host authorized a handler to request write effects.",
      "type": "string",
      "enum": [
        "read",
        "write"
      ]
    },
    "PluginDirectory": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updated_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "name",
        "kind",
        "revision",
        "created_at",
        "updated_at"
      ]
    }
  }
}
