{
  "$id": "urn:asset-hub:plugin-contract:resource-action-request-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginResourceActionRequest",
  "description": "Action request passed from host to a plugin handler.",
  "type": "object",
  "properties": {
    "access": {
      "$ref": "#/$defs/PluginActionAccess"
    },
    "action": {
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginContentBytes"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginContentReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "input": {
      "default": null
    },
    "resource": {
      "$ref": "#/$defs/PluginResource"
    }
  },
  "additionalProperties": false,
  "required": [
    "action",
    "access",
    "resource"
  ],
  "$defs": {
    "PluginActionAccess": {
      "description": "Whether the Host authorized a handler to request write effects.",
      "type": "string",
      "enum": [
        "read",
        "write"
      ]
    },
    "PluginChecksum": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ]
    },
    "PluginContentBytes": {
      "description": "Inline object content supplied to a plugin.",
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        },
        "encoding": {
          "$ref": "#/$defs/PluginInlineContentEncoding"
        }
      },
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ]
    },
    "PluginContentReference": {
      "description": "Non-inline object content supplied to a plugin.",
      "type": "object",
      "properties": {
        "encoding": {
          "$ref": "#/$defs/PluginContentReferenceEncoding"
        },
        "reference": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "encoding",
        "reference"
      ]
    },
    "PluginContentReferenceEncoding": {
      "description": "Encoding used by an opaque, call-scoped host content reference.",
      "type": "string",
      "enum": [
        "handle"
      ]
    },
    "PluginContentVerificationStatus": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "failed"
      ]
    },
    "PluginInlineContentEncoding": {
      "description": "Encoding accepted for content embedded directly in an action request.",
      "type": "string",
      "enum": [
        "base64"
      ]
    },
    "PluginResource": {
      "description": "Resource snapshot exposed to plugin handlers.",
      "type": "object",
      "properties": {
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginResourceContent"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string"
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "directory": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updated_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "directory",
        "name",
        "kind",
        "revision",
        "created_at",
        "updated_at"
      ]
    },
    "PluginResourceContent": {
      "description": "Resource content reference exposed to plugins.",
      "type": "object",
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginChecksum"
            },
            {
              "type": "null"
            }
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "verification_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "$ref": "#/$defs/PluginContentVerificationStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "size",
        "verification_status"
      ]
    }
  }
}
