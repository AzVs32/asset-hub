{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asset-hub.local/schemas/plugin-manifest-v3.json",
  "title": "Asset Hub Plugin Manifest V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "plugin", "runtime", "permissions"],
  "properties": {
    "$schema": { "type": "string" },
    "manifest_version": { "const": 3 },
    "plugin": { "$ref": "#/$defs/plugin" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "web": { "$ref": "#/$defs/web" },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "permissions": { "$ref": "#/$defs/permissions" }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9._:-]+$"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "publisher"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "builtin" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "wasm"],
          "properties": {
            "type": { "const": "extism" },
            "wasm": { "type": "string", "minLength": 1 },
            "wasi": { "type": "boolean", "default": false },
            "plugin_api": {
              "type": "string",
              "enum": ["asset-hub.plugin-api@0.1", "asset-hub.plugin-api@0.2"],
              "default": "asset-hub.plugin-api@0.2"
            }
          }
        }
      ]
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": { "root": { "type": "string", "minLength": 1 } }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kinds": { "type": "array", "items": { "$ref": "#/$defs/kind" }, "default": [] },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" }, "default": [] }
      }
    },
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/canonicalId" },
        "parent": { "$ref": "#/$defs/canonicalId" },
        "label": { "type": "string", "minLength": 1 },
        "supports_content": { "type": "boolean", "default": true },
        "detect": { "$ref": "#/$defs/contentMatcher" }
      }
    },
    "contentMatcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mime_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\." } }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "handler", "views"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "label": { "type": "string", "minLength": 1 },
        "handler": { "$ref": "#/$defs/canonicalId" },
        "applies_to": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kinds": { "type": "array", "items": { "$ref": "#/$defs/canonicalId" } },
            "media_types": { "type": "array", "items": { "type": "string" } },
            "extensions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "access": { "enum": ["read", "write"], "default": "read" },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "content": { "type": "boolean", "default": false },
            "content_delivery": { "enum": ["inline", "reference"] }
          }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["text", "markdown", "html", "plugin_frame", "json", "media", "binary_url", "table", "form"] }
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "group": { "type": "string" },
            "order": { "type": "integer" },
            "locations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["resource.metadata.read", "resource.metadata.write", "content.read", "content.replace", "derived_asset.write"] }
        },
        "network": {
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["hosts"],
              "properties": { "hosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
            }
          ]
        },
        "filesystem": {
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["read", "write"],
              "properties": {
                "read": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "write": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            }
          ]
        }
      }
    }
  }
}
