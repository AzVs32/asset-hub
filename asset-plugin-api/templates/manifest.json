{
  "$schema": "https://asset-hub.local/schemas/plugin-manifest-v3.json",
  "manifest_version": 3,
  "plugin": {
    "id": "example.plugin",
    "name": "Example Plugin",
    "version": "0.1.0",
    "publisher": "example",
    "description": "Replace this description with the plugin purpose."
  },
  "runtime": {
    "type": "extism",
    "wasm": "dist/plugin.wasm"
  },
  "capabilities": {
    "actions": [
      {
        "id": "example.plugin.action",
        "label": "Example Action",
        "handler": "run",
        "applies_to": {
          "kinds": ["core:file"]
        },
        "views": ["json"],
        "ui": {
          "group": "inspect",
          "order": 100,
          "locations": ["resource_detail"]
        }
      }
    ]
  },
  "permissions": {
    "allow": ["resource.read"]
  }
}
