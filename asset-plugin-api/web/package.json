{
  "name": "@asset-hub/plugin-web-sdk",
  "version": "0.3.0",
  "description": "Stable browser SDK for Asset Hub plugin frames.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22 <23"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/asset-hub-plugin.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/asset-hub-plugin.js",
  "scripts": {
    "build": "vite build && tsc --project tsconfig.json --emitDeclarationOnly",
    "check": "biome ci . && tsc --project tsconfig.json --noEmit",
    "format": "biome check --write .",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "penpal": "^7.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
